# Replo environment variables
#
# Use separate values for Vercel Production and Preview.
# Never commit real secret values.

# Required for diagnosis submissions and Supabase Auth.
# Production: production Supabase project
# Preview/Development: separate development Supabase project (recommended)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site origin used for OAuth and email authentication callbacks.
# Local: http://localhost:3000
# Preview: https://dev.replo.kr
# Production: https://replo.kr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Must match the Supabase project configured above.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only encryption secret for ChannelTalk Access Key/Secret.
# Use different secrets for Production and Preview.
INTEGRATION_ENCRYPTION_KEY=

# Required in Preview and Production for distributed diagnosis rate limiting.
# Upstash Redis integration variables are preferred. Legacy Vercel KV aliases
# KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-only diagnosis webhook. Do not prefix with NEXT_PUBLIC_.
DIAGNOSIS_WEBHOOK_URL=
DIAGNOSIS_WEBHOOK_SECRET=

# Optional server-only secret for scheduled API routes.
CRON_SECRET=

# Comma-separated allowlist for the read-only internal /admin page.
ADMIN_EMAILS=

# Optional. Keep unset until the real StepPay API contract is confirmed.
# Do not reuse production payment credentials in Preview.
STEPPAY_SECRET_TOKEN=
STEPPAY_API_BASE_URL=https://api.steppay.io/v1/subscriptions
STEPPAY_ALLOWED_REDIRECT_ORIGINS=
