# Replo homepage production environment variables

# Required for diagnosis form submissions and Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-only diagnosis webhook. Do not prefix with NEXT_PUBLIC_.
DIAGNOSIS_WEBHOOK_URL=
DIAGNOSIS_WEBHOOK_SECRET=

# Optional. Keep unset until the real StepPay API contract is confirmed.
STEPPAY_SECRET_TOKEN=
STEPPAY_API_BASE_URL=https://api.steppay.io/v1/subscriptions
STEPPAY_ALLOWED_REDIRECT_ORIGINS=
