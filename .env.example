# Replo public homepage environment variables
# Never commit real secret values.

# Supabase project used to store diagnosis submissions.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Required in Preview and Production for diagnosis rate limiting.
# Upstash Redis integration variables are preferred. Legacy Vercel KV aliases
# KV_REST_API_URL and KV_REST_API_TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional server-only diagnosis webhook. Do not prefix with NEXT_PUBLIC_.
DIAGNOSIS_WEBHOOK_URL=
DIAGNOSIS_WEBHOOK_SECRET=

# Facebook Pixel (client). Public by design. When empty, the pixel no-ops and no
# tracking script is loaded.
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=

# Meta Conversions API (server-only). Never prefix with NEXT_PUBLIC_.
# When META_PIXEL_ID or META_ACCESS_TOKEN is missing, /api/meta/conversions
# safely no-ops and never blocks the user flow.
# META_PIXEL_ID is usually the same numeric id as NEXT_PUBLIC_FACEBOOK_PIXEL_ID.
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Optional. Set to mirror events into Meta Events Manager "Test Events".
META_TEST_EVENT_CODE=
